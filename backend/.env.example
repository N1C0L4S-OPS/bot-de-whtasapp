# === BASE DE DATOS ===
# Literalmente la misma base y las mismas credenciales que el .env del sistema principal
# (consultorio-dental-oficial-my-dents-) — el bot no tiene su propio Postgres, comparte ese.
DB_CLIENT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydents
DB_USER=mydents
DB_PASSWORD=

# Mismo valor exacto que JWT_SECRET del sistema principal — el bot no tiene login propio,
# valida los mismos tokens que ya emite ese repo.
JWT_SECRET=

# === REDIS (colas BullMQ) ===
REDIS_HOST=localhost
REDIS_PORT=6379

# === CORS del panel admin (frontend/) ===
# Lista separada por comas de orígenes permitidos, ej: https://mensajeria.midominio.com
CORS_ORIGIN=

# === WHATSAPP CLOUD API (Meta) ===
# Estos valores se usan una sola vez para sembrar el channel_config inicial
# (npx knex seed:run) — después de eso, el bot los lee de la base, no de acá.
WHATSAPP_TOKEN=tu_token_de_acceso_permanente
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
WHATSAPP_VERIFY_TOKEN=mydents_verify_token_2026
WHATSAPP_APP_SECRET=tu_app_secret_de_meta
META_GRAPH_API_VERSION=v21.0

# === SERVIDOR ===
PORT=3001
HOST=0.0.0.0

# === MODO DE RESPUESTA (auto-respuesta genérica, fuera de confirmar/cancelar cita) ===
# known_patients = solo responde a pacientes registrados en la BD
# keyword = responde cuando escribe la palabra clave al inicio
# all = responde a todos (no recomendado)
RESPONSE_MODE=known_patients
KEYWORD_TRIGGER=PACIENTE

# === RECORDATORIOS ===
REMINDER_24H_HOUR=8
REMINDER_24H_MINUTE=0
REMINDER_3H_ENABLED=true

# === INFO DEL CONSULTORIO ===
CLINIC_NAME=Centro Odontológico MY DENT'S
CLINIC_ADDRESS=
CLINIC_PHONE=
