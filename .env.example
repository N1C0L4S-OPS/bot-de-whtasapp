# === BASE DE DATOS (misma que el sistema principal) ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydents
DB_USER=mydents
DB_PASSWORD=mydents_secure_2026

# === WHATSAPP CLOUD API (Meta) ===
WHATSAPP_TOKEN=tu_token_de_acceso_permanente
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
WHATSAPP_VERIFY_TOKEN=mydents_verify_token_2026
WHATSAPP_API_VERSION=v21.0

# === SERVIDOR WEB (GUI) ===
PORT=3001
HOST=0.0.0.0

# === MODO DE RESPUESTA ===
# known_patients = solo responde a pacientes registrados en la BD
# keyword = responde cuando escribe la palabra clave al inicio
# all = responde a todos (no recomendado)
RESPONSE_MODE=known_patients
KEYWORD_TRIGGER=PACIENTE

# === RECORDATORIOS ===
REMINDER_24H_HOUR=8
REMINDER_24H_MINUTE=0
REMINDER_3H_ENABLED=true

# === INFO DEL CONSULTORIO ===
CLINIC_NAME=Centro Odontológico MY DENT'S
CLINIC_ADDRESS=
CLINIC_PHONE=
